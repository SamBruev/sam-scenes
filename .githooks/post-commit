#!/bin/sh
# После коммита в SamScenes — push на GitHub Pages (SamBruev/sam-scenes).
# Включение: git config core.hooksPath .githooks

branch=$(git symbolic-ref --short HEAD 2>/dev/null) || exit 0
[ "$branch" = "main" ] || exit 0

if git push sam-scenes main; then
  version=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' build-info.json 2>/dev/null | head -1)
  [ -n "$version" ] || version="sync"
  printf '%s\n' "Sam Scenes: отправлено на https://github.com/SamBruev/sam-scenes (${version})."
else
  printf '%s\n' "Sam Scenes: git push sam-scenes main не удался — проверьте сеть и доступ." >&2
fi
